---
import CartBadge from "./CartBadge.jsx";

const links = [
  { href: "/catalogo", label: "Todo" },
  { href: "/catalogo?category=remeras", label: "Remeras" },
  { href: "/catalogo?category=buzos", label: "Buzos" },
  { href: "/catalogo?category=pantalones", label: "Pantalones" },
  { href: "/catalogo?category=accesorios", label: "Accesorios" },
];
---

<header class="border-b border-concrete/40 sticky top-0 z-40 bg-paper/95 backdrop-blur">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="font-display text-3xl tracking-tight leading-none">NULA</a>

      <nav class="hidden md:flex items-center gap-6 font-mono text-sm">
        {links.map((l) => (
          <a href={l.href} class="hover:text-olive transition-colors">{l.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-5">
        <a href="/login" class="hidden sm:inline font-mono text-sm hover:text-olive transition-colors">
          CUENTA
        </a>
        <CartBadge client:load />
      </div>
    </div>
  </div>
</header>
