---
import Layout from "../layouts/Layout.astro";
import DropHero from "../components/DropHero.astro";
import DropFloat from "../components/DropFloat.astro";
import ComboMarquee from "../components/ComboMarquee.astro";
import { api } from "../lib/api.js";

let featured = [];
try {
  featured = await api.getFeatured();
} catch {
  featured = [];
}
---

<Layout>
  <DropHero />

  <DropFloat garments={featured} />

  <ComboMarquee />
</Layout>
